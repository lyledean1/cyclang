expression_list = { SOI ~ ( stmt_inner | expression_list_inner ) ~ (WHITESPACE* ~ (stmt_inner | expression_list_inner )*) ~ EOI }
stmt_inner = _{ if_stmt | while_stmt | for_stmt | func_stmt | extern_func_stmt | import_stmt | struct_stmt | block_stmt | break_stmt | continue_stmt }
expression_list_inner = _{((( field_assign | index_stmt | let_stmt | len_stmt | print_stmt | call_stmt | expression | grouping | import_stmt ) ~ (semicolon ~ WHITESPACE? ~ (binary | field_assign | index_stmt | let_stmt | len_stmt | print_stmt | call_stmt | expression | grouping | import_stmt))*) ~ semicolon)}
expression = _ { binary | literal | struct_init | field_access }


// for loop
initialization = { "let" ~ name ~ WHITESPACE? ~ "=" ~ WHITESPACE? ~ number }
iteration = { name ~ WHITESPACE? ~ ("++" | "--") }
condition = { name ~ WHITESPACE? ~ ("<" | "<=" | ">" | ">=" ) ~ WHITESPACE? ~ number }
for_stmt = { "for" ~ WHITESPACE? ~ "(" ~ initialization ~ ";" ~ condition ~ ";" ~ iteration ~ ")" ~ block_stmt }

// logical types
if_stmt = { "if" ~ WHITESPACE? ~ "(" ~ (expression | name ) ~ ")" ~ WHITESPACE? ~ block_stmt ~ (WHITESPACE? ~ "else" ~ block_stmt)? }
while_stmt = {"while" ~ WHITESPACE? ~ "(" ~ (expression | name) ~ ")" ~ WHITESPACE? ~ block_stmt}
block_stmt = { "{" ~ WHITESPACE? ~ (return_stmt | expression_list_inner | stmt_inner | WHITESPACE?) ~ (WHITESPACE? ~ (return_stmt | expression_list_inner | stmt_inner)*) ~ (WHITESPACE*)? ~ return_stmt? ~ WHITESPACE? ~ "}" }
break_stmt = { "break" ~ WHITESPACE? ~ semicolon? }
continue_stmt = { "continue" ~ WHITESPACE? ~ semicolon? }

// let statements and functions
let_stmt = { (((("let" ~ WHITESPACE?)? ~ name)) ~ WHITESPACE?) ~ (colon ~ type_name ~ WHITESPACE?)? ~ assignment_stmt}
index_stmt = {list_index ~ WHITESPACE?  ~ assignment_stmt  }
assignment_stmt = _{equal ~ WHITESPACE? ~ (list_index | field_access | len_stmt | call_stmt | expression | grouping | name)}
func_stmt = { "fn" ~ WHITESPACE? ~ name ~ "(" ~ func_arg* ~ ")" ~ (WHITESPACE? ~ arrow ~ WHITESPACE? ~ type_name)? ~ WHITESPACE? ~ block_stmt }
extern_func_stmt = { "extern" ~ WHITESPACE? ~ "fn" ~ WHITESPACE? ~ name ~ "(" ~ func_arg* ~ ")" ~ (WHITESPACE? ~ arrow ~ WHITESPACE? ~ type_name)? ~ WHITESPACE? ~ semicolon? }
import_stmt = { "import" ~ WHITESPACE+ ~ import_name ~ WHITESPACE? ~ semicolon? }
import_name = @{ ASCII_ALPHA+ | string }
struct_stmt = { "struct" ~ name ~ "{" ~ struct_field* ~ "}" ~ semicolon? }
struct_field = { WHITESPACE? ~ name ~ WHITESPACE? ~ colon ~ WHITESPACE? ~ type_name ~ WHITESPACE? ~ semicolon? }
func_arg = { WHITESPACE? ~ type_name ~ WHITESPACE? ~ name ~ WHITESPACE? ~ comma? }
type_name = { base_type | list_type | struct_type }
struct_type = { name }
call_stmt = { qualified_name ~ "(" ~ (len_stmt | call_stmt | grouping | expression | name)? ~ (comma ~ (len_stmt | call_stmt | grouping | expression | name))* ~ ")" }
print_stmt = { "print(" ~ (len_stmt | call_stmt | list_index | field_access | expression | name ) ~ ")" }
len_stmt = { "len(" ~ (call_stmt | list_index | field_access | expression | name ) ~ ")" }
string_type = {"string"}
i32_type = {"i32"}
i64_type = {"i64"}
bool_type = { "bool"}
base_type = _{bool_type | i32_type | i64_type | string_type}
list_type = {"List<" ~  (base_type | list_type )~ ">"}
// binary statemeents
binary = {  &(operand ~ WHITESPACE? ~ operator) ~ operand ~ WHITESPACE? ~ operator_sequence }
operand = _{ literal ~ WHITESPACE? | grouping | call_stmt | field_access | name  }
operator_sequence = _{ operator ~ WHITESPACE* ~ operand ~ (WHITESPACE* ~ operator_sequence)? }
operator = { "==" | "!=" | ">=" | "<=" | ">" | "<" | "+" | "-" | "*" | "/" | "^" }

grouping = { "(" ~ expression ~ ")" }
literal = { number | string | bool | nil | list  }

struct_init = { name ~ WHITESPACE? ~ "{" ~ WHITESPACE? ~ struct_field_init* ~ WHITESPACE? ~ "}" }
struct_field_init = { WHITESPACE? ~ name ~ WHITESPACE? ~ colon ~ WHITESPACE? ~ (expression | name | call_stmt | grouping) ~ WHITESPACE? ~ semicolon? }
field_access = { (call_stmt | name | grouping) ~ ("." ~ name)+ }
field_assign = { field_access ~ WHITESPACE? ~ equal ~ WHITESPACE? ~ (expression | name | call_stmt | grouping) }

list = { lbracket ~ WHITESPACE? ~ literal ~ (WHITESPACE? ~ "," ~ WHITESPACE? ~ literal)* ~ rbracket }
list_index = {(call_stmt  |expression | name) ~ lbracket ~ (expression  |number | name | call_stmt) ~ rbracket}
keyword = { ("if" | "else" | "while" | "for" | "return" | "break" | "continue" | "fn" | "let" | "extern" | "module" | "import" | "struct" | "true" | "false" | "nil") ~ !(alpha | digits | "_") }
qualified_name = @{ (alpha | "_") ~ (alpha | digits | "_")* ~ ( "." ~ (alpha | digits | "_")+ )* }
name = @{ !keyword ~ (alpha | "_") ~ (alpha | digits | "_")* }
number = { "-"? ~ digits }
digits = @{ ASCII_DIGIT+ }
alpha = { ASCII_ALPHA | "_" }
string = { "\"" ~ ( "\\\\" | "\\\"" | "\\n" | "\\r" | "\\t" | (!"\"" ~ ANY) )* ~ "\"" }
nil = { "nil" }
bool = { "true" | "false" }
equal = { "=" }
semicolon = { ";" }
colon = { ":" }
arrow = { "->" }
lbracket  = {"["}
rbracket = {"]"}
return_keyword = _{ "return" }
return_stmt = { return_keyword ~ WHITESPACE? ~ (binary | grouping | literal | call_stmt | name)? ~ WHITESPACE? ~ semicolon? }
comma = { WHITESPACE? ~ "," ~ WHITESPACE? }
comment = _{ "//" ~ (!NEWLINE ~ ANY)* ~ (NEWLINE | EOI) }
WHITESPACE = _{ " " | "\t" | NEWLINE }
